# Reescribe rutas del framework fuente a rutas de instancia (in place). Args: archivos.
reescribir_instancia() {
  python3 - "$P60_REPO_URL" "$@" <<'EOF'
import re, sys
url, files = sys.argv[1], sys.argv[2:]
NB = r'(?<![\w/.-])'          # no precedido por parte de otra ruta
REGLAS = [
    (NB + r'\.p60/memory/',                     'p60/_framework/memory/'),
    (NB + r'\.p60/registry/',                   'p60/_framework/registry/'),
    (NB + r'docs/(P60-Framework-Guide\.md|arranque-rapido\.md|adr/)', r'p60/_framework/docs/\1'),
    (NB + r'skills/_index\.md',                 'p60/_framework/skills-index.md'),
    (NB + r'skills/_standards/SKILL-format\.md', url + '/blob/main/skills/_standards/SKILL-format.md'),
    (NB + r'_standards/component-spec\.md',     'p60/_framework/standards/component-spec.md'),
    (NB + r'templates/artifacts/',              'p60/_framework/templates/artifacts/'),
    (NB + r'agents/([a-z0-9-]+)\.md',           r'p60/_framework/agents/\1.md'),
    (NB + r'skills/([a-z0-9-]+)/',              r'.claude/skills/\1/'),
]
for f in files:
    s = open(f, encoding='utf-8').read(); o = s
    for pat, rep in REGLAS:
        s = re.sub(pat, rep, s)
    if s != o:
        open(f, 'w', encoding='utf-8').write(s)
EOF
}

# Fusiona el hook gate-zonas en .claude/settings.json sin pisar lo existente. Arg: ruta del json.
fusionar_settings() {
  python3 - "$1" <<'EOF'
import json, os, sys
p = sys.argv[1]
cmd = '"$CLAUDE_PROJECT_DIR"/p60/_framework/hooks/gate-zonas.sh'
try:
    d = json.load(open(p)) if os.path.exists(p) else {}
except ValueError:
    sys.exit("p60: .claude/settings.json no es JSON válido; no lo toco. Corrígelo y vuelve a correr init.")
pre = d.setdefault('hooks', {}).setdefault('PreToolUse', [])
if not any(h.get('command') == cmd for e in pre for h in e.get('hooks', [])):
    pre.append({"matcher": "Write|Edit|NotebookEdit", "hooks": [{"type": "command", "command": cmd}]})
os.makedirs(os.path.dirname(p), exist_ok=True)
with open(p, 'w') as fh:
    json.dump(d, fh, indent=2, ensure_ascii=False); fh.write('\n')
EOF
}

# Estado del hook en settings.json: create | merge | have
estado_settings() {
  [ -f "$1" ] || { echo create; return; }
  grep -q 'p60/_framework/hooks/gate-zonas.sh' "$1" && echo have || echo merge
}

# Inserta o reemplaza el bloque <!-- P60:BEGIN … P60:END --> en el CLAUDE.md de la raíz.
# Args: CLAUDE.md destino, archivo con el bloque.
bloque_claude() {
  python3 - "$1" "$2" <<'EOF'
import os, re, sys
dst, blk = sys.argv[1], open(sys.argv[2], encoding='utf-8').read().strip() + '\n'
s = open(dst, encoding='utf-8').read() if os.path.exists(dst) else ''
pat = re.compile(r'<!-- P60:BEGIN.*?<!-- P60:END -->\n?', re.S)
if pat.search(s):
    s = pat.sub(lambda _: blk, s, count=1)
else:
    s = (s.rstrip('\n') + '\n\n' if s.strip() else '') + blk
open(dst, 'w', encoding='utf-8').write(s)
EOF
}

# Escribe p60/_framework/manifest.json. Args: raíz instancia, versión, tools, ids agentes, ids skills.
escribir_manifiesto() {
  python3 - "$@" <<'EOF'
import hashlib, json, os, re, sys
root, version, tools, agentes, skills = sys.argv[1:6]
def sha(p): return 'sha256:' + hashlib.sha256(open(p, 'rb').read()).hexdigest()
files = {}
def add_tree(rel):
    base = os.path.join(root, rel)
    for d, _, fs in os.walk(base):
        for f in fs:
            p = os.path.join(d, f); r = os.path.relpath(p, root)
            if r != 'p60/_framework/manifest.json': files[r] = sha(p)
add_tree('p60/_framework')
for a in agentes.split():
    r = f'.claude/agents/{a}.md'; files[r] = sha(os.path.join(root, r))
for s in skills.split():
    add_tree(f'.claude/skills/{s}')
cm = open(os.path.join(root, 'CLAUDE.md'), encoding='utf-8').read()
blk = re.search(r'<!-- P60:BEGIN.*?<!-- P60:END -->', cm, re.S).group(0)
man = {
    "framework_version": version,
    "tools": tools.split(','),
    "files": dict(sorted(files.items())),
    "merged": {
        ".claude/settings.json": {"hooks.PreToolUse": "gate-zonas"},
        "CLAUDE.md": {"block": "P60", "sha256": hashlib.sha256(blk.encode()).hexdigest()},
    },
}
with open(os.path.join(root, 'p60/_framework/manifest.json'), 'w') as fh:
    json.dump(man, fh, indent=2, ensure_ascii=False); fh.write('\n')
EOF
}

# Marcadores típicos de un repo de código (para la regla del principio 3).
marcador_codigo() { # $1=carpeta → imprime el primer marcador encontrado
  local d="$1" x
  for x in package.json pyproject.toml requirements.txt go.mod Cargo.toml pom.xml build.gradle Gemfile composer.json src app; do
    [ -e "$d/$x" ] && { echo "$x"; return 0; }
  done
  ls "$d"/*.csproj >/dev/null 2>&1 && { echo "*.csproj"; return 0; }
  return 1
}

