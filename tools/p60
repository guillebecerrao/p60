# Componentes que distribuye el framework de este CLI → globals AGENTES, SKILLS (ids separados por espacio).
listar_componentes() {
  AGENTES=""; SKILLS=""; local a s
  for a in "$P60_ROOT"/.claude/agents/*.md; do AGENTES="$AGENTES $(basename "$a" .md)"; done
  for s in "$P60_ROOT"/skills/*/; do s=$(basename "$s"); [ "$s" = "_standards" ] || SKILLS="$SKILLS $s"; done
}

# Escribe todo lo GESTIONADO por p60 bajo la raíz $1: p60/_framework/ (sin config ni manifiesto)
# y la capa del adaptador claude (.claude/agents, .claude/skills). La usan init y update.
generar_gestionados() { # $1=raíz destino  $2=lang
  local root="$1" fw="$1/p60/_framework" a s f
  listar_componentes
  mkdir -p "$fw/memory" "$fw/registry" "$fw/agents" "$fw/hooks" "$fw/docs" "$fw/standards" "$fw/templates"
  cp "$P60_ROOT/.p60/memory/constitution.md" "$fw/memory/"
  cp "$P60_ROOT/.p60/registry/agents.yaml" "$fw/registry/"
  cp "$P60_ROOT"/agents/*.md "$fw/agents/"
  cp "$P60_ROOT/_standards/component-spec.md" "$fw/standards/"
  cp -R "$P60_ROOT/templates/artifacts" "$fw/templates/"
  cp "$P60_ROOT/tools/hooks/gate-zonas.sh" "$fw/hooks/"; chmod +x "$fw/hooks/gate-zonas.sh"
  cp "$P60_ROOT/docs/P60-Framework-Guide.md" "$P60_ROOT/docs/arranque-rapido.md" "$fw/docs/"
  cp -R "$P60_ROOT/docs/adr" "$fw/docs/"
  sed -E 's#\]\(([a-z0-9-]+)/SKILL\.md\)#](../../.claude/skills/\1/SKILL.md)#' "$P60_ROOT/skills/_index.md" > "$fw/skills-index.md"
  printf '%s\n' "$P60_VERSION" > "$fw/VERSION"
  mkdir -p "$root/.claude/agents" "$root/.claude/skills"
  for a in $AGENTES; do cp "$P60_ROOT/.claude/agents/$a.md" "$root/.claude/agents/$a.md"; done
  for s in $SKILLS; do rm -rf "$root/.claude/skills/$s"; cp -R "$P60_ROOT/skills/$s" "$root/.claude/skills/$s"; done
  find "$fw" "$root/.claude/skills" -name .DS_Store -delete 2>/dev/null || true
  local md=()
  while IFS= read -r f; do md+=("$f"); done < <(
    find "$fw" "$root/.claude/skills" -type f \( -name '*.md' -o -name '*.yaml' \)
    for a in $AGENTES; do echo "$root/.claude/agents/$a.md"; done
  )
  reescribir_instancia "${md[@]}"
}

escribir_config() { # $1=raíz $2=producto $3=escala $4=lang $5=tools $6=installed_at
  cat > "$1/p60/_framework/config.yaml" <<EOF
# Generado por p60 init. Lo actualiza p60 update.
producto: $2
escala: $3
lang: $4
tools: [$5]
framework_version: $P60_VERSION
framework_source: $P60_REPO_URL
installed_at: $6
updated_at: $HOY
EOF
}

# Raíz de la instancia P60 que contiene a $1 (default: carpeta actual), o falla.
instancia_raiz() {
  local d; d=$(cd "${1:-.}" 2>/dev/null && pwd -P) || return 1
  while :; do
    [ -f "$d/p60/_framework/manifest.json" ] && { echo "$d"; return 0; }
    [ "$d" = "/" ] && return 1
    d=$(dirname "$d")
  done
}

config_get() { # $1=raíz $2=clave
  awk -v k="$2" -F': *' '$1==k{print $2; exit}' "$1/p60/_framework/config.yaml" | tr -d '[]'
}

cmd_update() {
  local ruta="." dry=0 yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) dry=1; shift;;
      --yes|-y)  yes=1; shift;;
      -*)        die "flag desconocido: $1";;
      *)         ruta="$1"; shift;;
    esac
  done
  LANG_P60=es
  local root; root=$(instancia_raiz "$ruta") || { m u_notinst >&2; exit 1; }
  LANG_P60=$(config_get "$root" lang); LANG_P60=${LANG_P60:-es}
  local interactivo=0; [ -t 0 ] && [ "$yes" -eq 0 ] && interactivo=1
  local inst_ver tools producto escala installed
  inst_ver=$(cat "$root/p60/_framework/VERSION" 2>/dev/null || echo "?")
  tools=$(config_get "$root" tools); tools=${tools:-claude}
  producto=$(config_get "$root" producto); escala=$(config_get "$root" escala)
  installed=$(config_get "$root" installed_at)

  # Versión nueva generada aparte, con la misma función que init
  local tmp; tmp=$(mktemp -d "${TMPDIR:-/tmp}/p60-update.XXXXXX")
  trap "rm -rf '$tmp'" EXIT
  generar_gestionados "$tmp" "$LANG_P60"
  bloque_claude "$tmp/CLAUDE.md" "$P60_ROOT/templates/context-repo/$LANG_P60/root-claude-block.md"
  escribir_manifiesto "$tmp" "$P60_VERSION" "$tools" "$AGENTES" "$SKILLS"

  # Plan: compara manifiesto instalado (base) · disco (tuyo) · versión nueva
  local plan="$tmp/plan.tsv"
  python3 - "$root" "$tmp" > "$plan" <<'EOF'
import hashlib, json, os, sys
root, tmp = sys.argv[1:3]
old = json.load(open(os.path.join(root, 'p60/_framework/manifest.json')))['files']
new = json.load(open(os.path.join(tmp, 'p60/_framework/manifest.json')))['files']
def disco(p):
    f = os.path.join(root, p)
    return 'sha256:' + hashlib.sha256(open(f, 'rb').read()).hexdigest() if os.path.isfile(f) else None
for p in sorted(set(old) | set(new)):
    o, n, d = old.get(p), new.get(p), disco(p)
    if n and not o:
        acc = 'add' if d is None else ('same' if d == n else 'collide')
    elif o and not n:
        acc = 'gone' if d is not None else 'same'
    elif d == n:
        acc = 'same'
    elif d is None:
        acc = 'add'              # gestionado y borrado localmente: se restaura
    elif d == o:
        acc = 'replace'          # sin cambios locales, cambió en el framework
    elif n == o:
        acc = 'keep'             # cambio local, el framework no lo tocó
    else:
        acc = 'conflict'         # cambió en los dos lados
    if acc != 'same':
        print(f'{acc}\t{p}')
EOF

  titulo "$(m u_title "$producto" "$inst_ver" "$P60_VERSION")"
  if ! grep -qv '^keep	' "$plan"; then   # nada que aplicar (a lo sumo, tus cambios que se mantienen)
    fusionar_settings "$root/.claude/settings.json"
    m u_uptodate "$P60_VERSION"; exit 0
  fi
  local acc ruta_f
  for acc in replace add keep conflict collide gone; do
    grep -q "^$acc	" "$plan" || continue
    say ""; m "h_$acc"
    grep "^$acc	" "$plan" | cut -f2 | sed 's/^/  · /'
  done
  if [ "$dry" -eq 1 ]; then say ""; m dry; exit 0; fi

  local resp=""
  if [ "$interactivo" -eq 1 ]; then
    say ""; read -r -p "$(m u_ask)" resp
    case "$resp" in ""|s|S|y|Y|si|sí|yes) ;; *) m cancel; exit 0;; esac
  elif [ "$yes" -eq 0 ]; then
    say ""; m u_needyes >&2; exit 2
  fi

  say ""
  while IFS='	' read -r acc ruta_f; do
    case "$acc" in
      replace|add)
        mkdir -p "$(dirname "$root/$ruta_f")"; cp "$tmp/$ruta_f" "$root/$ruta_f";;
      keep) ;;
      conflict|collide)
        resp="g"
        if [ "$interactivo" -eq 1 ]; then
          [ -f "$root/$ruta_f" ] && diff -u "$root/$ruta_f" "$tmp/$ruta_f" | head -40 || true
          read -r -p "$(m u_conf_ask "$ruta_f")" resp </dev/tty; resp=${resp:-g}
        fi
        case "$resp" in
          t|T|p|P) mkdir -p "$(dirname "$root/$ruta_f")"; cp "$tmp/$ruta_f" "$root/$ruta_f";;
          m|M|k|K) ;;
          *)       mkdir -p "$(dirname "$root/$ruta_f")"; cp "$tmp/$ruta_f" "$root/$ruta_f.p60-new"
                   m u_conf_yes "$ruta_f" "$ruta_f";;
        esac;;
      gone)
        resp="n"
        [ "$interactivo" -eq 1 ] && { read -r -p "$(m u_del_ask "$ruta_f")" resp </dev/tty || true; }
        case "$resp" in s|S|y|Y|si|sí|yes) rm -f "$root/$ruta_f";; *) m u_del_keep "$ruta_f";; esac;;
    esac
  done < "$plan"

  # Fragmentos fusionados, manifiesto (base = versión nueva) y config
  fusionar_settings "$root/.claude/settings.json"
  bloque_claude "$root/CLAUDE.md" "$P60_ROOT/templates/context-repo/$LANG_P60/root-claude-block.md"
  cp "$tmp/p60/_framework/manifest.json" "$root/p60/_framework/manifest.json"
  escribir_config "$root" "$producto" "$escala" "$LANG_P60" "$tools" "${installed:-$HOY}"
  say ""; m u_done "$P60_VERSION"
}

# Diagnóstico de una instancia (si la carpeta actual está dentro de una).
doctor_instancia() { # $1=raíz → imprime checks; devuelve 1 si hay FAIL
  local root="$1" fallos=0 iv
  LANG_P60=$(config_get "$root" lang); LANG_P60=${LANG_P60:-es}
  say ""; m d_inst "$root"
  iv=$(cat "$root/p60/_framework/VERSION" 2>/dev/null || echo "?")
  if [ "$iv" = "$P60_VERSION" ]; then m d_ver_ok "$iv"; else m d_ver_old "$iv" "$P60_VERSION"; fi
  local estado
  estado=$(python3 - "$root" <<'EOF'
import hashlib, json, os, sys
root = sys.argv[1]
files = json.load(open(os.path.join(root, 'p60/_framework/manifest.json')))['files']
for p, h in sorted(files.items()):
    f = os.path.join(root, p)
    if not os.path.isfile(f): print('miss\t' + p)
    elif 'sha256:' + hashlib.sha256(open(f, 'rb').read()).hexdigest() != h: print('mod\t' + p)
print('total\t%d' % len(files))
EOF
)
  local acc ruta_f total=0 sucio=0
  while IFS='	' read -r acc ruta_f; do
    case "$acc" in
      total) total="$ruta_f";;
      mod)   m d_mod "$ruta_f"; sucio=1;;
      miss)  m d_miss "$ruta_f"; sucio=1; fallos=1;;
    esac
  done <<< "$estado"
  [ "$sucio" -eq 0 ] && m d_clean "$total"
  if [ "$(estado_settings "$root/.claude/settings.json")" = "have" ] && [ -x "$root/p60/_framework/hooks/gate-zonas.sh" ]; then
    m d_hook_ok
  else
    m d_hook_no; fallos=1
  fi
  local links; links=$(cd "$root" && find p60 .claude -type l 2>/dev/null | head -3 | tr '\n' ' ')
  [ -n "$links" ] && m d_links "$links"
  [ "$(pwd -P)" != "$root" ] && m d_sub "$root"
  return "$fallos"
}

# Actualiza la instalación global (~/.p60) reutilizando el install.sh de esta versión.
cmd_self_update() {
  local to=""
  while [ $# -gt 0 ]; do
    case "$1" in --to) to="$2"; shift 2;; *) die "flag desconocido: $1";; esac
  done
  case "$P60_ROOT" in
    */versions/*) ;;
    *) case "${LANG:-}" in
         en*) die "this p60 runs from a clone ($P60_ROOT): update it with git pull";;
         pt*) die "este p60 roda a partir de um clone ($P60_ROOT): atualize com git pull";;
         *)   die "este p60 corre desde un clon ($P60_ROOT): actualízalo con git pull";;
       esac;;
  esac
  local prefix bindir enlace
  prefix=$(cd -P "$P60_ROOT/../.." && pwd)
  enlace=$(command -v p60 || true); bindir=$(dirname "${enlace:-$HOME/.local/bin/p60}")
  bash "$P60_ROOT/install.sh" --prefix "$prefix" --bin-dir "$bindir" ${to:+--version "$to"}
}

cmd_init() {
  local ruta="" producto="" escala="" lang="" tools="claude" dry=0 yes=0 overwrite=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --producto) producto="$2"; shift 2;;
      --escala)   escala="$2"; shift 2;;
      --lang)     lang="$2"; shift 2;;
      --tools)    tools="$2"; shift 2;;
      --dry-run)  dry=1; shift;;
      --yes|-y)   yes=1; shift;;
      --overwrite) overwrite=1; shift;;
      --dir)      die "--dir ya no existe: usa 'p60 init RUTA' (la carpeta indicada es el context repo)";;
      -*)         die "flag desconocido: $1";;
      *)          [ -z "$ruta" ] || die "sobra un argumento: $1"; ruta="$1"; shift;;
    esac
  done
  ruta="${ruta:-.}"
  [ -e "$ruta" ] && [ ! -d "$ruta" ] && die "$ruta existe y no es una carpeta"
  local abs; abs=$(python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$ruta")
  local interactivo=0; [ -t 0 ] && [ "$yes" -eq 0 ] && interactivo=1

  # Wizard (solo pregunta lo que falta y solo si hay terminal)
  local sugerido; sugerido=$(basename "$abs" | tr 'A-Z' 'a-z' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  if [ -z "$producto" ]; then
    if [ "$interactivo" -eq 1 ]; then read -r -p "Nombre del producto (kebab-case) [$sugerido]: " producto; fi
    producto="${producto:-$sugerido}"
  fi
  echo "$producto" | grep -Eq '^[a-z0-9][a-z0-9-]*$' || die "el nombre debe ser kebab-case ([a-z0-9-]): '$producto'"
  if [ -z "$escala" ]; then
    [ "$interactivo" -eq 1 ] && read -r -p "Escala del equipo [pb=product-builder solo | triada | squad] (pb): " escala
    escala="${escala:-pb}"
  fi
  case "$escala" in pb|triada|squad) ;; *) die "escala inválida: $escala (pb|triada|squad)";; esac
  if [ -z "$lang" ]; then
    [ "$interactivo" -eq 1 ] && read -r -p "Idioma del contenido [es=español | en=english | pt=português BR] (es): " lang
    lang="${lang:-es}"
  fi
  case "$lang" in es|en|pt) ;; *) die "idioma inválido: $lang (es|en|pt)";; esac
  LANG_P60="$lang"
  local t; for t in $(echo "$tools" | tr ',' ' '); do
    case " $TOOLS_SOPORTADAS " in *" $t "*) ;; *) die "herramienta no soportada: $t (soportadas hoy: $TOOLS_SOPORTADAS)";; esac
  done
  local tpl="$P60_ROOT/templates/context-repo/$lang"

  # ── Pre-flight: qué se crea, qué se fusiona, qué choca ──
  [ -d "$abs/p60/_framework" ] && { m installed >&2; exit 2; }
  listar_componentes
  local agentes="$AGENTES" skills="$SKILLS" a s colisiones=""
  [ -e "$abs/p60" ] && colisiones="$colisiones p60/"
  for a in $agentes; do [ -e "$abs/.claude/agents/$a.md" ] && colisiones="$colisiones .claude/agents/$a.md"; done
  for s in $skills; do [ -e "$abs/.claude/skills/$s" ] && colisiones="$colisiones .claude/skills/$s/"; done

  local en_repo=0 top="" sonda="$abs"
  while [ ! -d "$sonda" ]; do sonda=$(dirname "$sonda"); done   # RUTA puede no existir aún
  if git -C "$sonda" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    en_repo=1; top=$(git -C "$sonda" rev-parse --show-toplevel)
  fi
  local codigo=""
  [ -d "$abs" ] && codigo=$(marcador_codigo "$abs" || true)
  [ -z "$codigo" ] && [ -n "$top" ] && codigo=$(marcador_codigo "$top" || true)

  local est_settings est_claude="cm_create"
  est_settings=$(estado_settings "$abs/.claude/settings.json")
  if [ -f "$abs/CLAUDE.md" ]; then
    grep -q '<!-- P60:BEGIN' "$abs/CLAUDE.md" && est_claude="cm_replace" || est_claude="cm_append"
  fi
  local con_contenido=0; [ -d "$abs" ] && [ -n "$(ls -A "$abs" 2>/dev/null)" ] && con_contenido=1

  titulo "p60 init — $(m plan)"
  m dest "$abs"
  m prod "$producto" "$escala" "$lang" "$tools"
  say ""
  m c_p60
  m c_fw "$P60_VERSION"
  m c_claude "$(echo $agentes | wc -w | tr -d ' ')" "$(echo $skills | wc -w | tr -d ' ')"
  m "s_$est_settings"
  m "$est_claude"
  if [ "$en_repo" -eq 1 ]; then m g_keep "$top"; else m g_init; fi
  [ "$en_repo" -eq 1 ] && [ "$top" != "$abs" ] && m w_sub "$abs"
  if [ -n "$colisiones" ]; then
    say ""; m col_h; for a in $colisiones; do say "  ! $a"; done
  fi
  if [ -n "$codigo" ]; then say ""; m codebase "$codigo"; fi
  if [ "$dry" -eq 1 ]; then say ""; m dry; exit 0; fi

  # ── Confirmaciones (puerta humana) ──
  local resp=""
  if [ -n "$colisiones" ] && [ "$overwrite" -eq 0 ]; then
    [ "$interactivo" -eq 1 ] || { say ""; m col_abort >&2; exit 2; }
    say ""; read -r -p "$(m col_ask)" resp
    case "$resp" in s|S|y|Y|si|sí|yes) ;; *) m cancel; exit 2;; esac
  elif [ "$con_contenido" -eq 1 ] && [ "$interactivo" -eq 1 ]; then
    say ""; read -r -p "$(m go_ask)" resp
    case "$resp" in ""|s|S|y|Y|si|sí|yes) ;; *) m cancel; exit 0;; esac
  fi

  # ── 1) Estructura del equipo en p60/ ──
  local p="$abs/p60" fw="$abs/p60/_framework"
  local carpetas=(
    "contexto/negocio" "contexto/mercado-usuario" "contexto/equipo" "contexto/dominio"
    "contexto/estrategia" "contexto/evidencia/_inbox" "contexto/evidencia/fichas" "contexto/evidencia/originales"
    "shape/entrevistas/transcripciones" "shape/entrevistas/snapshots" "shape/_retro"
    "ideate/oportunidades" "ideate/_retro"
    "validate/oportunidades" "validate/_retro"
    "handoff-delivery/epicas" "handoff-delivery/_retro"
    "experimentacion/experimentos"
    "bitacora" "presentaciones" "_historia" "legacy"
  )
  local c; for c in "${carpetas[@]}"; do mkdir -p "$p/$c"; touch "$p/$c/.keep"; done

  # ── 2) Semillas localizadas (placeholders: [PRODUCTO], [FECHA], [VERSION]) ──
  instanciar() { # $1=origen relativo al template  $2=destino absoluto
    mkdir -p "$(dirname "$2")"
    sed -e "s|\[PRODUCTO\]|$producto|g" -e "s|\[FECHA\]|$HOY|g" -e "s|\[VERSION\]|$P60_VERSION|g" "$tpl/$1" > "$2"
  }
  local sem
  for sem in CLAUDE.md framework.md README.md contexto/evidencia/_index.md \
             bitacora/bitacora-agentica.md bitacora/bitacora-humana.md experimentacion/pipeline.md; do
    instanciar "$sem" "$p/$sem"
  done
  ost_semilla "$producto" "$p/contexto/estrategia/ost.md"

  # ── 3) Framework vendorizado + adaptador (misma función que usa update) ──
  generar_gestionados "$abs" "$lang"
  escribir_config "$abs" "$producto" "$escala" "$lang" "$tools" "$HOY"
  fusionar_settings "$abs/.claude/settings.json"
  bloque_claude "$abs/CLAUDE.md" "$tpl/root-claude-block.md"
  escribir_manifiesto "$abs" "$P60_VERSION" "$tools" "$AGENTES" "$SKILLS"

  # ── 4) Git: solo si no había repo. El commit incluye solo lo que creó p60 ──
  if [ "$en_repo" -eq 0 ]; then
    ( cd "$abs" && git init -q && git add p60 .claude CLAUDE.md \
      && git commit -qm "p60 init — $producto (escala: $escala, lang: $lang, P60 v$P60_VERSION)" )
  fi

  proximos_pasos "$ruta"
}

case "${1:-help}" in
  init)    shift; cmd_init "$@";;
  update)  shift; cmd_update "$@";;
  self-update) shift; cmd_self_update "$@";;
  skills)  cmd_skills;;
  agents)  cmd_agents;;
  lint)    cmd_lint;;
  doctor)  cmd_doctor;;
  version|--version) cmd_version;;
  help|--help|-h) cmd_help;;
  *) die "comando desconocido: $1 (p60 help)";;
esac
